rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all incoming requests
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict User-Isolation Fortress
    // Only the authenticated user can access any subcollections under their own users/{uid}/**
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Recursive match for all subcollections under users/{uid}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
